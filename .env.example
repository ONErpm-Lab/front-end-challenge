# Spotify app credentials (https://developer.spotify.com/dashboard).
# Server-side only (Client Credentials flow) — never expose these to the browser.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional
PORT=4000

# Production only: hosts the SSR server may answer for (comma separated). Without it, Angular 21
# falls back to client-side rendering and the page loses its server-rendered language.
# NG_ALLOWED_HOSTS=example.com
