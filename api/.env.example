# live = Spotify real (precisa das credenciais e de Premium no dono do app)
# mock = catálogo de demonstração, sem rede (padrão quando não há credenciais)
SPOTIFY_MODE=mock

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Só no modo mock: 'down' simula o Spotify fora do ar; 'partial' faz um único ISRC falhar.
# Latência simulada em ms.
SPOTIFY_MOCK_SCENARIO=ok
SPOTIFY_MOCK_LATENCY_MS=400

PORT=3000
